## Atelier Plateau theme
## by Bram de Haan (http://atelierbramdehaan.nl)

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#8a8585"

# Title color for boxes
theme[title]="#e7dfdf"

# Higlight color for keyboard shortcuts
theme[hi_fg]="#7272ca"

# Background color of selected item in processes box
theme[selected_bg]="#292424"

# Foreground color of selected item in processes box
theme[selected_fg]="#e7dfdf"

# Color of inactive/disabled text
theme[inactive_fg]="#8464c4"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#4b8b8b"

# Cpu box outline color
theme[cpu_box]="#8464c4"

# Memory/disks box outline color
theme[mem_box]="#8464c4"

# Net up/down box outline color
theme[net_box]="#8464c4"

# Processes box outline color
theme[proc_box]="#8464c4"

# Box divider line and small boxes line color
theme[div_line]="#8464c4"

# Temperature graph colors
theme[temp_start]="#5485b6"
theme[temp_mid]="#a06e3b"
theme[temp_end]="#ca4949"

# CPU graph colors
theme[cpu_start]="#5485b6"
theme[cpu_mid]="#a06e3b"
theme[cpu_end]="#ca4949"

# Mem/Disk free meter
theme[free_start]="#ca4949"
theme[free_mid]="#a06e3b"
theme[free_end]="#5485b6"

# Mem/Disk cached meter
theme[cached_start]="#5485b6"
theme[cached_mid]="#a06e3b"
theme[cached_end]="#ca4949"

# Mem/Disk available meter
theme[available_start]="#ca4949"
theme[available_mid]="#a06e3b"
theme[available_end]="#5485b6"

# Mem/Disk used meter
theme[used_start]="#5485b6"
theme[used_mid]="#a06e3b"
theme[used_end]="#ca4949"

# Download graph colors
theme[download_start]="#ca4949"
theme[download_mid]="#a06e3b"
theme[download_end]="#5485b6"

# Upload graph colors
theme[upload_start]="#ca4949"
theme[upload_mid]="#a06e3b"
theme[upload_end]="#5485b6"