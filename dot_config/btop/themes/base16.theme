## eldritch theme
## by https://github.com/eldritch-theme

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#ebfafa"

# Title color for boxes
theme[title]="#f0f2f4"

# Higlight color for keyboard shortcuts
theme[hi_fg]="#39ddfd"

# Background color of selected item in processes box
theme[selected_bg]="#323449"

# Foreground color of selected item in processes box
theme[selected_fg]="#f0f2f4"

# Color of inactive/disabled text
theme[inactive_fg]="#a48cf2"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#37f499"

# Cpu box outline color
theme[cpu_box]="#a48cf2"

# Memory/disks box outline color
theme[mem_box]="#a48cf2"

# Net up/down box outline color
theme[net_box]="#a48cf2"

# Processes box outline color
theme[proc_box]="#a48cf2"

# Box divider line and small boxes line color
theme[div_line]="#a48cf2"

# Temperature graph colors
theme[temp_start]="#04d1f9"
theme[temp_mid]="#f1fc79"
theme[temp_end]="#f16c75"

# CPU graph colors
theme[cpu_start]="#04d1f9"
theme[cpu_mid]="#f1fc79"
theme[cpu_end]="#f16c75"

# Mem/Disk free meter
theme[free_start]="#f16c75"
theme[free_mid]="#f1fc79"
theme[free_end]="#04d1f9"

# Mem/Disk cached meter
theme[cached_start]="#04d1f9"
theme[cached_mid]="#f1fc79"
theme[cached_end]="#f16c75"

# Mem/Disk available meter
theme[available_start]="#f16c75"
theme[available_mid]="#f1fc79"
theme[available_end]="#04d1f9"

# Mem/Disk used meter
theme[used_start]="#04d1f9"
theme[used_mid]="#f1fc79"
theme[used_end]="#f16c75"

# Download graph colors
theme[download_start]="#f16c75"
theme[download_mid]="#f1fc79"
theme[download_end]="#04d1f9"

# Upload graph colors
theme[upload_start]="#f16c75"
theme[upload_mid]="#f1fc79"
theme[upload_end]="#04d1f9"